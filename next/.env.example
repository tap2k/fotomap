# Public URL of this app (used in emails and share links)
APP_URL=http://localhost:3000
# Random string, 32+ chars. Signs local upload URLs.
SECRET=change-me-to-a-long-random-string

# Database: local SQLite file by default, or Turso (libsql://...)
DATABASE_URL=file:.data/fotomap.db
# DATABASE_AUTH_TOKEN=

# Storage: leave S3_BUCKET unset to store files in .data/uploads
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=https://media.example.com

# Email (magic links). Unset in development: links are printed to the console.
# SMTP_URL=smtp://user:pass@smtp.example.com:587
# MAIL_FROM=Fotomap <noreply@example.com>

# Google sign-in (optional)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Map style (MapLibre style JSON). Default: OpenFreeMap, free, no key.
# NEXT_PUBLIC_MAP_STYLE=https://tiles.openfreemap.org/styles/liberty

# Plan limits: set to true to enforce lib/plans.ts
# TIER_ENFORCEMENT=true
